# =============================================================================
# Protection for the health check directory.
#
# health-check.php stays reachable (it needs to be, for Uptime Kuma); everything
# else in this directory — above all .env, which holds HEALTH_TOKEN — is denied.
#
# NOTE: HumHub's own root .htaccess only blocks dotfiles at the root of the
# webroot (`RedirectMatch 403 ^/?\.`), so a `.env` in a subdirectory like this
# one is NOT covered by it. This file is what protects it.
# =============================================================================

# No directory listing.
Options -Indexes

# Never let the server hand out anything but the script itself.
<IfModule mod_authz_core.c>
    # Apache 2.4+
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(env|example|dist|md|json|log|bak|old|ini|yml|yaml|txt|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    # Apache 2.2
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(env|example|dist|md|json|log|bak|old|ini|yml|yaml|txt|sh)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Belt and braces: if mod_rewrite is available, 404 anything that is not the
# health check entry point.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule !^health-check\.php$ - [R=404,L]
</IfModule>

# --- Optional: restrict by IP as well ----------------------------------------
# Uncomment and list your Uptime Kuma host(s). The HEALTH_TOKEN still applies.
