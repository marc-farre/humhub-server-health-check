# =============================================================================
# health-check.php configuration
# -----------------------------------------------------------------------------
# Copy to `.env` in the same directory as health-check.php, then:
#     chmod 600 .env
# Every value below is optional — the defaults are shown in [brackets].
# A real environment variable of the same name overrides the value here.
# =============================================================================

# --- Identity -----------------------------------------------------------------
# Shown in the output; helps when several servers alert at once. [hostname]
# Example: HEALTH_LABEL="intranet.example.org (staging)"
HEALTH_LABEL=

# --- HTTP access --------------------------------------------------------------
# REQUIRED for HTTP access. Without it the script refuses every web request.
# Generate with:  openssl rand -hex 32
# Call it as ?token=..., or send it as `X-Health-Token:` / `Authorization: Bearer`.
HEALTH_TOKEN=

# Optional extra restriction: only these IPs may call the script over HTTP.
# Space or comma separated. Empty = any IP with a valid token. []
HEALTH_ALLOW_IPS=

# Return HTTP 503 for warnings as well, not only for errors. [false]
HTTP_FAIL_ON_WARNING=false

# --- Which application? -------------------------------------------------------
# humhub  : HumHub-specific checks are active — supported PHP range per HumHub
#           release, required extensions, protected/ and uploads/ permissions,
#           cron/run + queue/run, protected/config/dynamic.php, and so on.
# generic : every HumHub assumption is dropped. The script then checks the server
#           (disk, inodes, load, memory, PHP settings, OPcache, temp dirs, cron
#           PHP versions, .env safety) plus whatever you declare below, so it can
#           monitor any PHP application. [humhub]
APP_TYPE=humhub

# Name shown in the output when APP_TYPE=generic. [application]
APP_NAME=

# --- Application paths --------------------------------------------------------
# Root of the application (for HumHub: the directory holding index.php +
# protected/).
# [auto-detected: this directory, its parent, or its grandparent]
# In generic mode, leave empty to run server-level checks only.
# Examples: /var/www/app  ~/sites/example.org  /home/site/public_html
APP_PATH=
# HUMHUB_PATH is still accepted as an alias for APP_PATH.
HUMHUB_PATH=

# Public base URL, used by the web exposure self-test. []
# Example: BASE_URL=https://app.example.org
BASE_URL=

# Files or directories that must exist, relative to APP_PATH. Generic mode only;
# in HumHub mode index.php, protected/yii and vendor/autoload.php are checked.
# Example: APP_REQUIRED_FILES=public/index.php,vendor/autoload.php
APP_REQUIRED_FILES=

# Directories that must be writable, relative to APP_PATH.
# HumHub default: [assets uploads uploads/file uploads/profile_image
#                  protected/config protected/modules protected/runtime]
# Generic default: none — declare your own, e.g. var/cache,var/log,storage
APP_WRITABLE_DIRS=
# HUMHUB_WRITABLE_DIRS is still accepted as an alias.
HUMHUB_WRITABLE_DIRS=

# Also require the application root itself to be writable (HumHub's built-in
# updater needs this; leave false if you deploy with git/composer). [false]
CHECK_ROOT_WRITABLE=false

# In generic mode, drop every application-level check in one go and monitor the
# server only — equivalent to skipping app_install, app_permissions, security,
# web_exposure, cron and logs. [false]
SKIP_APP_CHECKS=false

# --- Disk ---------------------------------------------------------------------
# Partitions to check. [HUMHUB_PATH]
DISK_PATHS=
DISK_ERROR_FREE_GB=5
DISK_WARN_FREE_GB=10
DISK_ERROR_FREE_PERCENT=3
DISK_WARN_FREE_PERCENT=8
# Inode exhaustion breaks uploads while `df -h` still looks fine. [true]
DISK_CHECK_INODES=true
DISK_MAX_INODE_PERCENT=90

# --- PHP ----------------------------------------------------------------------
# In HumHub mode the required PHP version range is derived from the installed
# HumHub version (protected/humhub/config/common.php + the support matrix in the
# script), and these act as fallbacks when HumHub cannot be located.
# In generic mode they are the only source: leave both empty to skip the check.
PHP_MIN_VERSION=8.2
PHP_MAX_VERSION=

# Pin the expected PHP version instead of comparing cron against the web SAPI.
# Example: PHP_EXPECTED_VERSION=8.4 — then every PHP command in the crontab that
# belongs to this installation must resolve to PHP 8.4. []
PHP_EXPECTED_VERSION=

# Override the extension lists if your setup legitimately differs. In generic
# mode there is no default required list — declare what your app needs, or leave
# it empty to skip the check.
# HumHub default: [gd curl mbstring pdo pdo_mysql zip exif intl fileinfo json iconv]
PHP_REQUIRED_EXTENSIONS=
# HumHub default: [openssl sodium xml apcu ldap "Zend OPcache"]
# Generic default: ["Zend OPcache"]
PHP_RECOMMENDED_EXTENSIONS=

PHP_MIN_MEMORY_LIMIT_MB=128
PHP_MIN_MAX_EXECUTION_TIME=30
PHP_MIN_UPLOAD_MB=32
# Warn when display_errors is On for the web SAPI. [true]
PHP_CHECK_DISPLAY_ERRORS=true

OPCACHE_MAX_USED_PERCENT=90

# --- Cron ---------------------------------------------------------------------
# Where to read the crontab from. If unset, `crontab -l` is used (needs exec()).
# On Infomaniak the user crontab is readable via `crontab -l` over SSH. []
CRONTAB_FILE=

# Optional: point the cron/queue output at log files (see the HumHub cron docs)
# and this script will alert when they stop being written.
#   * * * * * <php> <humhub>/protected/yii cron/run  >/path/to/cron.log 2>&1
#   * * * * * <php> <humhub>/protected/yii queue/run >/path/to/queue.log 2>&1
CRON_LOG_FILE=
QUEUE_LOG_FILE=
CRON_LOG_MAX_AGE_MINUTES=15

# The crontab is in the system format (/etc/crontab, /etc/cron.d/*), where a user
# name follows the schedule. Auto-detected when CRONTAB_FILE is under /etc/cron.
# [auto]
CRONTAB_USER_FIELD=

# Console commands that must be scheduled. HumHub default: [cron/run queue/run].
# Generic default: none — the cron check then only verifies that the PHP binaries
# used by jobs inside APP_PATH match the web PHP version.
CRON_REQUIRED_ACTIONS=

# Warn when a cron job calls `php` without pinning a version in the path. Cron's
# PATH is minimal and the default `php` is often an older version. [true]
CRON_REQUIRE_PINNED_PHP=true

# --- Load / memory ------------------------------------------------------------
LOAD_WARN_PER_CORE=2.0
LOAD_ERROR_PER_CORE=4.0
MEMORY_WARN_FREE_PERCENT=10
MEMORY_ERROR_FREE_PERCENT=5
SWAP_WARN_USED_PERCENT=50

# --- Security -----------------------------------------------------------------
# Config files that must not be world-readable, relative to APP_PATH — they
# usually hold database credentials or API keys.
# HumHub default: protected/config/dynamic.php
# Example: SENSITIVE_FILES=config/db.php,.env.local
SENSITIVE_FILES=

# Files whose absence means the web server is not blocking a sensitive path,
# relative to APP_PATH. In HumHub mode protected/.htaccess and
# uploads/file/.htaccess are checked automatically.
# Example: REQUIRED_DENY_FILES=storage/.htaccess
REQUIRED_DENY_FILES=

# --- Logs ---------------------------------------------------------------------
# Directory to inspect: absolute, or relative to APP_PATH. HumHub default is
# protected/runtime/logs. Empty disables the log checks.
# Example: LOG_DIR=var/log
LOG_DIR=

# File inside LOG_DIR scanned for recent errors. [app.log]
LOG_FILE=

LOG_MAX_TOTAL_MB=512
LOG_ERROR_WINDOW_MINUTES=60
LOG_ERROR_THRESHOLD=25
LOG_TAIL_KB=512

# --- Web exposure self-test ---------------------------------------------------
# off | cli | always. `cli` (default) avoids an FPM worker calling itself, which
# can deadlock a small pool. [cli]
WEB_EXPOSURE_CHECK=cli
# [/protected/config/dynamic.php /protected/humhub/config/common.php]
WEB_EXPOSURE_PATHS=
# Public path of this .env; auto-derived when the script sits under the webroot.
WEB_EXPOSURE_ENV_PATH=
WEB_EXPOSURE_TIMEOUT=5

# --- Misc ---------------------------------------------------------------------
# Extra paths that must be writable (absolute, space or comma separated). []
EXTRA_WRITABLE_PATHS=

# Shared state between the CLI and web runs (PHP version / user / timezone
# comparison). Give a directory, a full file path, or neither — the fallback is
# HumHub's protected/runtime, otherwise the system temp directory.
HEALTH_STATE_DIR=
HEALTH_STATE_FILE=
STATE_MAX_AGE_DAYS=30

# Check ids to skip or to run exclusively. `php health-check.php --list` shows
# the ids: disk php_version php_extensions php_settings opcache load memory
# temp_dirs app_install app_permissions security web_exposure cron
# sapi_consistency logs
# (humhub_install / humhub_permissions still work as aliases for the app_* ids.)
HEALTH_SKIP_CHECKS=
HEALTH_ONLY_CHECKS=
